# Supabase — copy to .env.local and fill from your project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for privileged operations (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# Android App Links (MP-030). The SHA-256 fingerprint of the certificate the
# DELIVERED app is signed with — for a Play-signed release that is Google's key,
# not your upload keystore. Served at /.well-known/assetlinks.json; without it
# that route returns 503 and https links keep opening the browser instead of the
# app. Comma-separate to list more than one (e.g. Play + a local debug build).
# Not a secret: a certificate fingerprint is public by design. See
# docs/android-app-links.md for exactly where to copy it from.
# Example shape: AA:BB:CC:...:99  (32 hex pairs)
ANDROID_APP_CERT_SHA256=
# Apple Team ID, for iOS Universal Links (B-26). Ten characters, from
# developer.apple.com/account -> Membership. Served at
# /.well-known/apple-app-site-association; without it that route returns 503 and
# every https link keeps opening Safari instead of the app. The full form
# (TEAMID.com.matjarlb.app) is accepted too.
# Not a secret: a Team ID is public in every app you have ever shipped. See
# docs/ios-universal-links.md.
IOS_APP_TEAM_ID=

# Extra hostnames this deployment may act as the WebAuthn relying party for
# (MP-014). The clock-in rpID and expected origin used to be whatever the
# request's Host header said, which let the caller choose the scope a
# fingerprint credential is bound to. They are now checked against a list built
# from NEXT_PUBLIC_SITE_URL, the Vercel per-deployment hostnames, localhost in
# development — and this. Set it only for a host none of those cover: an
# apex/www pair, a staging domain, a custom preview. Comma-separate; a bare host
# or a full URL both work. Not a secret.
# Example: www.matjarlb.com,staging.matjarlb.com
WEBAUTHN_ALLOWED_HOSTS=

# Native (FCM/APNs) push opt-in. Leave unset until the FCM HTTP v1 sender that
# reads device_push_tokens actually exists — on iOS the permission prompt can be
# shown once per install, and there is no point spending it on a channel that
# cannot deliver. Set to 1 on the same deploy the sender ships. Web Push is
# separate and unaffected.
NEXT_PUBLIC_NATIVE_PUSH_ENABLED=

# Outgoing e-mail (0343): order/booking alerts to merchants and reminder nudges.
# Fill ONE of the two. With neither, nothing is e-mailed (push still works).
# a) resend.com — the sending domain must be verified there.
RESEND_API_KEY=
EMAIL_FROM=noreply@matjarlb.com
# b) any SMTP mailbox, e.g. Hostinger: smtp.hostinger.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
