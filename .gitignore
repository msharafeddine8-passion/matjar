# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e artifacts — traces and screenshots of failed runs)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is the opposite of a secret: every value in it
# is blank and its whole job is to tell the next person which variables exist.
#  was swallowing it, so seven documented variables — including the two
# that decide whether deep links work at all — lived only on one laptop.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent worktrees: full checkouts of this repo living inside it.
.claude/worktrees/

# Full before/after screenshot sweeps from scripts/shots-professional.mjs.
# 70 PNGs and 21MB per run, regenerable in one command, and permanent once it
# is in git history. The handful that carry the argument live in
# docs/professional-v2/key/ and ARE committed.
docs/professional-v2/before/
docs/professional-v2/after/

# Full before/after screenshot sweeps from scripts/shots-prelaunch.mjs (204 PNGs).
# The STATUS.md tables next to them are kept.
audit/prelaunch-v2/shots/**/*.png
